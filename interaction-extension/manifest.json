{
    "manifest_version": 3,
    "name": "Interaction Transfer",
    "version": "1.0",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://your-web-app.com/*",
        "https://target-website.com/*"
    ],
    "background": {
        "service_worker": "background/service-worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "file:///*",
                "http://127.0.0.1:5500/*",
                "http://127.0.0.1/*",
                "http://localhost/*"
            ],
            "js": [
                "webapp.js"
            ]
        },
        {
            "matches": [
                "https://hedrine.ulb.be/*"
            ],
            "js": [
                "target.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}